99.62-10.94 98.71-11.21L98.71-11.21L98.02-11.42L98.02-12.05L102.67-12.05L102.67-11.42L101.90-11.04Q101.45-10.82 101.23-10.57Q101.02-10.32 100.82-9.79L100.82-9.79L97.39-0.36L96.14 0.24L92.64-8.64Z';
---

<header class="nav" data-nav>
  <nav class="nav-capsule" aria-label="Main" data-nav-capsule>
    <a class="nav-logo" href="/" aria-label="Taskflow, home">
      <svg
        class="nav-logo__svg"
        viewBox="-20 -19 123.67 20.24"
        width="122"
        height="20"
        aria-hidden="true"
      >
        <line x1="-19" y1="-16.44" x2="-5" y2="-16.44" class="nav-logo__rule" />
        <line x1="-12" y1="-16.44" x2="-12" y2="0" class="nav-logo__rule" />
        <rect x="-11.2" y="-10.2" width="5.6" height="4" rx="1.3" class="nav-logo__chip" />
        <path d={WORDMARK_D} class="nav-logo__word" />
      </svg>
    </a>

    <div class="nav-links">
      <a href="#type-it">How it works</a>
      <a href="#keys">Shortcuts</a>
    </div>

    <div class="nav-cluster">
      <p class="nav-clock" aria-hidden="true">
        <span class="nav-clock__dot"></span>
        <span id="nav-clock-time"></span>
      </p>
      <span class="nav-divider" aria-hidden="true"></span>
      <a class="nav-signin" href="/app/login">Sign in</a>
      <a class="btn nav-cta" href="/app/signup">Start free</a>
      <button
        class="nav-burger"
        type="button"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Open menu"
        data-nav-burger
      >
        <span class="nav-burger__l1"></span>
        <span class="nav-burger__l2"></span>
      </button>
    </div>
  </nav>

  <div class="nav-mobile-menu" id="nav-mobile-menu" hidden data-nav-menu>
    <a href="#type-it">How it works</a>
    <a href="#keys">Shortcuts</a>
    <hr />
    <a href="/app/login">Sign in</a>
  </div>
</header>

<noscript>
  <style>
    .nav-clock {
      display: none;
    }
  </style>
</noscript>

<style>
  /* ============ capsule ============ */
  .nav {
    position: relative;
    z-index: 100;
  }

  .nav-capsule {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top, 0px));
    left: calc(20px + env(safe-area-inset-left, 0px));
    right: calc(20px + env(safe-area-inset-right, 0px));
    max-width: 1220px;
    margin-inline: auto;
    height: 60px;
    display: flex;
    align-items: center;
    border-radius: 12px;
    padding-inline: 20px;
    z-index: 100;
    /* never :hidden — a focus ring on a link near the rounded corner would
       otherwise be clipped by the capsule's own clip box (spec Risk #1). */
    overflow: visible;
    background: color-mix(in oklab, var(--void) 55%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    border: 1px solid color-mix(in oklab, var(--ink) 8%, transparent);
    /* resting: inset top-highlight only, no cast shadow — nothing is under
       the capsule yet at the top of the page. This box-shadow never
       transitions (see .nav-capsule::after below); it stays constant on
       the base element in both scroll states. */
    box-shadow: inset 0 1px 0 rgb(246 248 248 / 0.1);
  }

  /* Scrolled state is pre-rendered on a ::after pseudo-element and
     crossfaded via opacity only — box-shadow itself is never transitioned
     (synthesis (c) Nav #2). The brighter border + penumbra both live here,
     stacked exactly over the base capsule box. */
  .nav-capsule::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid color-mix(in oklab, var(--ink) 14%, transparent);
    box-shadow: var(
      --shadow-penumbra,
      0 0.6px 1.6px -1.5px rgb(0 0 0 / 0.5),
      0 2.3px 6px -3px rgb(0 0 0 / 0.4),
      0 10px 26px -4.5px rgb(0 0 0 / 0.28)
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease-out);
  }

  .nav-capsule.is-scrolled::after {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .nav-capsule {
      padding-inline: 16px;
    }
  }

  /* ============ logo — the single-SVG lockup ============ */
  /* Structural guard (spec Risk #1): no plate, no background rect, no
     border around the mark. This IS the fix for "reads as a button" — do
     not add a container with padding/radius/background around the <svg>. */
  .nav-logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    margin-right: 28px;
    color: var(--ink);
    text-decoration: none;
    transition: opacity 100ms var(--ease-out);
  }

  .nav-logo:active {
    opacity: 0.8;
  }

  .nav-logo__svg {
    display: block;
  }

  .nav-logo__rule {
    stroke: var(
      --line-dim,
      color-mix(in oklab, oklch(0.8 0.09 190) 30%, transparent)
    );
    stroke-width: 1.2;
    fill: none;
    stroke-linecap: butt;
  }

  .nav-logo__chip {
    /* the ONE aqua pixel in the whole logo — a cell with a task placed in
       it, the same idea the whole product sells. Static; no rim-flash
       (synthesis (c) Nav #1 cuts the one-shot). */
    fill: var(--aqua);
  }

  .nav-logo__word {
    fill: var(--ink);
  }

  /* ============ nav links ============ */
  .nav-links {
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: 8px;
    font: 400 13px/1 var(--font-sans);
    color: var(--ink-muted);
    text-decoration: none;
    background: transparent;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  @media (hover: hover) {
    .nav-links a:hover {
      color: var(--ink);
      background: color-mix(in oklab, var(--ink) 7%, transparent);
    }
  }

  .nav-links a:active {
    opacity: 0.8;
  }

  @media (max-width: 720px) {
    .nav-links {
      display: none;
    }
  }

  /* ============ right cluster: clock, divider, sign-in, CTA ============ */
  .nav-cluster {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: 32px;
  }

  .nav-clock {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    /* Static dot — the two-tempo ambient budget for this fold already
       belongs to the hero (idler drift / now-line). See spec Risk #6. */
  }

  .nav-clock__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--aqua);
    flex: none;
  }

  .nav-divider {
    width: 1px;
    height: 16px;
    background: var(--hairline-strong);
  }

  .nav-signin {
    padding: 8px 12px;
    border-radius: 8px;
    font: 500 13px/1 var(--font-sans);
    color: var(--ink-2);
    text-decoration: none;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  @media (hover: hover) {
    .nav-signin:hover {
      color: var(--ink);
      background: color-mix(in oklab, var(--ink) 7%, transparent);
    }
  }

  .nav-signin:active {
    opacity: 0.8;
  }

  @media (max-width: 720px) {
    .nav-clock,
    .nav-divider,
    .nav-signin {
      display: none;
    }
  }

  /* ============ CTA — de-glowed, local override (spec Risk #2) ============ */
  /* Overrides `.btn`/`.btn-primary` locally regardless of the shared
     global.css state, so this component is correct on its own. No outer
     aqua bloom anywhere — reads as a lit instrument key, not a sign. */
  .nav-cta {
    padding: 9px 16px;
    border-radius: 8px;
    font: 500 13px/1 var(--font-sans);
    white-space: nowrap;
    flex: none;
    background: var(--aqua);
    color: var(--aqua-ink);
    box-shadow:
      var(--edge-machined),
      var(
        --shadow-penumbra,
        0 0.6px 1.6px -1.5px rgb(0 0 0 / 0.5),
        0 2.3px 6px -3px rgb(0 0 0 / 0.4),
        0 10px 26px -4.5px rgb(0 0 0 / 0.28)
      );
    transition:
      background-color 150ms var(--ease-out),
      transform 100ms var(--ease-out);
  }

  .nav-cta:hover {
    background: var(--aqua-hover);
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  @media (max-width: 720px) {
    .nav-cta {
      padding: 9px 14px;
    }
  }

  /* ============ mobile hamburger + menu ============ */
  .nav-burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    flex: none;
  }

  @media (max-width: 720px) {
    .nav-burger {
      display: flex;
    }
  }

  .nav-burger__l1,
  .nav-burger__l2 {
    position: absolute;
    width: 20px;
    height: 1.6px;
    background: var(--ink);
    border-radius: 1px;
    transition: transform 200ms var(--ease-settle);
  }

  .nav-burger__l1 {
    transform: translateY(-4px);
  }

  .nav-burger__l2 {
    transform: translateY(4px);
  }

  .nav-burger.is-open .nav-burger__l1 {
    transform: translateY(0) rotate(45deg);
  }

  .nav-burger.is-open .nav-burger__l2 {
    transform: translateY(0) rotate(-45deg);
  }

  .nav-mobile-menu {
    position: fixed;
    top: calc(16px + 60px + 8px + env(safe-area-inset-top, 0px));
    left: calc(20px + env(safe-area-inset-left, 0px));
    right: calc(20px + env(safe-area-inset-right, 0px));
    background: var(--surface-3);
    border-radius: 12px;
    box-shadow: var(--edge-machined), var(--shadow-2);
    padding: 8px;
    z-index: 99;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 180ms var(--ease-settle),
      transform 180ms var(--ease-settle);
  }

  .nav-mobile-menu[data-open] {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-mobile-menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 12px;
    border-radius: 8px;
    font: 500 15px/1.2 var(--font-sans);
    color: var(--ink);
    text-decoration: none;
  }

  .nav-mobile-menu a:active {
    background: color-mix(in oklab, var(--ink) 7%, transparent);
  }

  .nav-mobile-menu hr {
    border: 0;
    height: 1px;
    background: var(--hairline);
    margin: 6px 4px;
  }

  @media (min-width: 721px) {
    .nav-mobile-menu,
    .nav-burger {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Scroll state: pre-rendered penumbra crossfade, 8px threshold.
    var capsule = document.querySelector('[data-nav-capsule]');
    function onScroll() {
      if (window.scrollY > 8) capsule.classList.add('is-scrolled');
      else capsule.classList.remove('is-scrolled');
    }
    if (capsule) {
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Live clock — window.TF.fmtClock is seeded synchronously in
    // Layout.astro's <head>, before this body script runs, so it is always
    // safe to call here at top level (foundation contract, synthesis (d)).
    var clockEl = document.getElementById('nav-clock-time');
    function updateClock() {
      if (clockEl && window.TF && typeof window.TF.fmtClock === 'function') {
        clockEl.textContent = window.TF.fmtClock(new Date());
      }
    }
    if (clockEl) {
      updateClock();
      var msToNextMinute = 60000 - (Date.now() % 60000);
      setTimeout(function () {
        updateClock();
        setInterval(updateClock, 60000);
      }, msToNextMinute);
    }

    // Mobile menu — disclosure pattern, no focus trap.
    var burger = document.querySelector('[data-nav-burger]');
    var menu = document.querySelector('[data-nav-menu]');
    var closeTimer = null;

    function isOpen() {
      return burger.getAttribute('aria-expanded') === 'true';
    }

    function openMenu() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      menu.hidden = false;
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Close menu');
      burger.classList.add('is-open');
      requestAnimationFrame(function () {
        menu.setAttribute('data-open', '');
      });
      var firstLink = menu.querySelector('a');
      if (firstLink) firstLink.focus();
    }

    function closeMenu(returnFocus) {
      menu.removeAttribute('data-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open menu');
      burger.classList.remove('is-open');
      if (returnFocus) burger.focus();
      var delay = window.TF && window.TF.reducedMotion ? 0 : 180;
      closeTimer = setTimeout(function () {
        menu.hidden = true;
      }, delay);
    }

    if (burger && menu) {
      burger.addEventListener('click', function () {
        if (isOpen()) closeMenu(false);
        else openMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen()) closeMenu(true);
      });

      document.addEventListener('click', function (e) {
        if (!isOpen()) return;
        if (menu.contains(e.target) || burger.contains(e.target)) return;
        closeMenu(false);
      });
    }
  })();
</script>
