---
// Spec 6.2 / _synthesis.md (c) TypeIt: "Type it. It lands."
// One composer runs a real type -> parse-reveal -> hold -> untype loop
// through six persona sentences (weighted: student, school kid, mother,
// father, tech professional, business person), forever while on screen.
// Copy is verbatim from _synthesis.md (e)/(f): the six persona sentences,
// chip labels, offer strings and mini-column data are the parser-verified
// set, superseding typeit.md's own persona table per synthesis (c)#1.
---

<section class="section" id="type-it">
  <div class="container ti-grid">
    <div class="copy" data-reveal>
      <h2 class="display-section">Type it. It lands.</h2>
      <p class="body-copy">
        Dates hide in the words you already use. Taskflow reads them as you
        type, offers the slot, and one Enter places the task on your week.
      </p>
    </div>
    <figure
      class="demo"
      role="img"
      aria-label="Animated demo: as you type a task, Taskflow highlights the date, the priority, and any person, place, or label it recognizes, then places the task on the week. The demo cycles through example sentences automatically."
      data-reveal
      data-ti-root
    >
      <div class="composer">
        <div class="input-well" data-ti-input>
          <span data-ti-text></span><span
            class="ti-caret is-hidden"
            data-ti-caret
            aria-hidden="true"></span>
        </div>
        <div class="chip-row" data-ti-chips aria-hidden="true"></div>
        <div class="offer" data-ti-offer aria-hidden="true">
          <span class="offer-text" data-ti-offer-text></span>
          <kbd class="key mono" data-ti-kbd>&#9166;</kbd>
        </div>
      </div>
      <svg class="ti-link" aria-hidden="true" focusable="false">
        <path data-ti-path></path>
        <path data-ti-path-live></path>
      </svg>
      <div class="mini-col" data-ti-mini aria-hidden="true">
        <div class="mini-head">
          <span class="dow mono" data-ti-dow></span>
        </div>
        <div class="mini-body">
          <span class="mini-hour mono" data-ti-hour-a></span>
          <span class="mini-hour mono" data-ti-hour-b></span>
          <div
            class="chip mini-chip-placed flashable"
            data-ti-placedchip
            style="--chip-c:var(--aqua)"
          >
            <span class="c-t mono" data-ti-placedtime></span>
            <span class="c-ti" data-ti-placedtitle></span>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<script is:inline>
  (function () {
    'use strict';

    var EASE_SETTLE = 'cubic-bezier(0.16,1,0.3,1)';
    var EASE_OUT = 'cubic-bezier(0.25,1,0.5,1)';
    var TYPE_MS = 38;
    var TYPE_JITTER = 6;
    var BACKSPACE_MS = 15;
    var TAG_STAGGER = 110;
    var HOLD_MS = 1700;
    var INTER_PERSONA_GAP = 260;

    var ICONS = {
      clock: '<circle cx="6" cy="6" r="5"/><path d="M6 6V3.2M6 6h2.2"/>',
      alert:
        '<path d="M6 2.2v4.6"/><circle class="ti-dot" cx="6" cy="9.3" r="0.75"/>',
      person:
        '<circle cx="6" cy="4" r="2"/><path d="M2.4 10c0-2 1.6-3.6 3.6-3.6S9.6 8 9.6 10"/>',
      pin: '<path d="M6 1c-2.2 0-4 1.7-4 4 0 3 4 6.5 4 6.5s4-3.5 4-6.5c0-2.3-1.8-4-4-4z"/><circle cx="6" cy="5" r="1.3"/>',
      briefcase:
        '<rect x="2" y="4.5" width="8" height="5.5" rx="1"/><path d="M4.5 4.5v-1a1.5 1.5 0 0 1 1.5-1.5 1.5 1.5 0 0 1 1.5 1.5v1"/>',
      house: '<path d="M2 6.5 6 2.5l4 4"/><path d="M3.5 5.5V10h5V5.5"/>',
      book: '<path d="M6 3.1C4.9 2.3 3.5 2 2.2 2v7.3c1.3 0 2.7.3 3.8 1.1 1.1-.8 2.5-1.1 3.8-1.1V2C8.5 2 7.1 2.3 6 3.1z"/><path d="M6 3.1v7.3"/>',
    };

    // Kind -> curated hue / icon / mono-label. Aqua stays the one
    // live/placed signal; every other kind renders in a curated hue
    // (design-brief §2.4), never aqua. Synthesis (c)#2 adds `edu` (yellow).
    var TAG_META = {
      edu: { hue: 'var(--hue-yellow)', icon: 'book', mono: false },
      'priority-high': { hue: 'var(--hue-red)', icon: 'alert', mono: false },
      'priority-low': { hue: 'var(--hue-slate)', icon: 'alert', mono: false },
      person: { hue: 'var(--hue-violet)', icon: 'person', mono: false },
      location: { hue: 'var(--hue-green)', icon: 'pin', mono: false },
      'label-personal': {
        hue: 'var(--hue-orange)',
        icon: 'house',
        mono: false,
      },
      'label-work': { hue: 'var(--hue-blue)', icon: 'briefcase', mono: false },
      time: { hue: 'var(--aqua)', icon: 'clock', mono: true },
    };

    // The six personas, verbatim per _synthesis.md (e)/(f). `segments`
    // cover the sentence in typed order (plain runs + tagged runs); `chips`
    // list the chip-row/reveal order: the two context tags in their
    // sentence order, then the aqua time chip last (synthesis (c)#3).
    var PERSONAS = [
      {
        // 1. Student
        segments: [
          { text: 'Study', tag: 'edu' },
          { text: ' group at the library ', tag: null },
          { text: 'saturday 9-11am', tag: 'time' },
          { text: ', midterm is ', tag: null },
          { text: 'important', tag: 'priority-high' },
        ],
        chips: [
          { tagKey: 'edu', label: 'EDUCATION' },
          { tagKey: 'priority-high', label: 'HIGH PRIORITY' },
          { tagKey: 'time', label: 'SAT 9:00-11:00 AM' },
        ],
        offer: { weekday: 'Saturday', time: '9:00-11:00 AM' },
        mini: {
          dow: 'SAT',
          range: true,
          labelA: { top: '2%', text: '9 AM' },
          labelB: { top: '96%', text: '11 AM' },
          chip: {
            top: '4%',
            height: '92%',
            time: '09:00-11:00',
            title: 'Study group',
          },
        },
      },
      {
        // 2. School kid
        segments: [
          { text: 'Play date with ', tag: null },
          { text: 'Jordan', tag: 'person' },
          { text: ' ', tag: null },
          { text: 'wednesday at 4pm', tag: 'time' },
          { text: ', mom says ', tag: null },
          { text: 'no rush', tag: 'priority-low' },
        ],
        chips: [
          { tagKey: 'person', label: 'JORDAN' },
          { tagKey: 'priority-low', label: 'LOW PRIORITY' },
          { tagKey: 'time', label: 'WED 4:00 PM' },
        ],
        offer: { weekday: 'Wednesday', time: '4:00 PM' },
        mini: {
          dow: 'WED',
          range: false,
          labelA: { top: '25%', text: '3 PM' },
          labelB: { top: '75%', text: '5 PM' },
          chip: { top: '50%', height: '25%', time: '16:00', title: 'Play date' },
        },
      },
      {
        // 3. Mother
        segments: [
          { text: 'Take ', tag: null },
          { text: 'Emma', tag: 'person' },
          { text: ' to the ', tag: null },
          { text: 'dentist', tag: 'label-personal' },
          { text: ' ', tag: null },
          { text: 'next tuesday 3pm', tag: 'time' },
        ],
        chips: [
          { tagKey: 'person', label: 'EMMA' },
          { tagKey: 'label-personal', label: 'PERSONAL' },
          { tagKey: 'time', label: 'TUE 3:00 PM' },
        ],
        offer: { weekday: 'Tuesday', time: '3:00 PM' },
        mini: {
          dow: 'TUE',
          range: false,
          labelA: { top: '25%', text: '2 PM' },
          labelB: { top: '75%', text: '4 PM' },
          chip: { top: '50%', height: '25%', time: '15:00', title: 'Dentist' },
        },
      },
      {
        // 4. Father
        segments: [
          { text: 'Pick up cleats from the ', tag: null },
          { text: 'store', tag: 'location' },
          { text: ' ', tag: null },
          { text: 'asap', tag: 'priority-high' },
          { text: ', practice ', tag: null },
          { text: 'saturday 9am', tag: 'time' },
        ],
        chips: [
          { tagKey: 'location', label: 'STORE' },
          { tagKey: 'priority-high', label: 'HIGH PRIORITY' },
          { tagKey: 'time', label: 'SAT 9:00 AM' },
        ],
        offer: { weekday: 'Saturday', time: '9:00 AM' },
        mini: {
          dow: 'SAT',
          range: false,
          labelA: { top: '25%', text: '8 AM' },
          labelB: { top: '75%', text: '10 AM' },
          chip: { top: '50%', height: '25%', time: '09:00', title: 'Practice' },
        },
      },
      {
        // 5. Tech professional
        segments: [
          { text: 'Send sprint ', tag: null },
          { text: 'report', tag: 'label-work' },
          { text: ' to ', tag: null },
          { text: 'Ana', tag: 'person' },
          { text: ' before ', tag: null },
          { text: 'friday 5pm', tag: 'time' },
        ],
        chips: [
          { tagKey: 'label-work', label: 'WORK' },
          { tagKey: 'person', label: 'ANA' },
          { tagKey: 'time', label: 'FRI 5:00 PM' },
        ],
        offer: { weekday: 'Friday', time: '5:00 PM' },
        mini: {
          dow: 'FRI',
          range: false,
          labelA: { top: '25%', text: '4 PM' },
          labelB: { top: '75%', text: '6 PM' },
          chip: {
            top: '50%',
            height: '25%',
            time: '17:00',
            title: 'Sprint report',
          },
        },
      },
      {
        // 6. Business person
        segments: [
          { text: 'Board ', tag: null },
          { text: 'meeting', tag: 'label-work' },
          { text: ' at the ', tag: null },
          { text: 'office', tag: 'location' },
          { text: ' moved to ', tag: null },
          { text: 'next monday 10am', tag: 'time' },
        ],
        chips: [
          { tagKey: 'label-work', label: 'WORK' },
          { tagKey: 'location', label: 'OFFICE' },
          { tagKey: 'time', label: 'MON 10:00 AM' },
        ],
        offer: { weekday: 'Monday', time: '10:00 AM' },
        mini: {
          dow: 'MON',
          range: false,
          labelA: { top: '25%', text: '9 AM' },
          labelB: { top: '75%', text: '11 AM' },
          chip: {
            top: '50%',
            height: '25%',
            time: '10:00',
            title: 'Board meeting',
          },
        },
      },
    ];
    PERSONAS.forEach(function (p) {
      p.text = p.segments
        .map(function (s) {
          return s.text;
        })
        .join('');
    });

    var rootEl = document.querySelector('[data-ti-root]');
    if (!rootEl) return;

    var els = {
      root: rootEl,
      demo: rootEl,
      text: rootEl.querySelector('[data-ti-text]'),
      caret: rootEl.querySelector('[data-ti-caret]'),
      chips: rootEl.querySelector('[data-ti-chips]'),
      offer: rootEl.querySelector('[data-ti-offer]'),
      offerText: rootEl.querySelector('[data-ti-offer-text]'),
      kbd: rootEl.querySelector('[data-ti-kbd]'),
      pathDim: rootEl.querySelector('[data-ti-path]'),
      pathLive: rootEl.querySelector('[data-ti-path-live]'),
      dow: rootEl.querySelector('[data-ti-dow]'),
      hourA: rootEl.querySelector('[data-ti-hour-a]'),
      hourB: rootEl.querySelector('[data-ti-hour-b]'),
      placedChip: rootEl.querySelector('[data-ti-placedchip]'),
      placedTime: rootEl.querySelector('[data-ti-placedtime]'),
      placedTitle: rootEl.querySelector('[data-ti-placedtitle]'),
    };

    function buildRun(tagKey) {
      var meta = TAG_META[tagKey];
      var run = document.createElement('span');
      run.className = 'ti-run';
      run.style.setProperty('--chip-c', meta.hue);
      var base = document.createElement('span');
      base.className = 'ti-run__base';
      var lit = document.createElement('span');
      lit.className = 'ti-run__lit';
      lit.setAttribute('aria-hidden', 'true');
      run.appendChild(base);
      run.appendChild(lit);
      return { el: run, base: base, lit: lit };
    }

    function buildChip(tagKey, label, mono) {
      var meta = TAG_META[tagKey];
      var chip = document.createElement('span');
      chip.className = 'ti-chip';
      chip.style.setProperty('--chip-c', meta.hue);
      var base = document.createElement('span');
      base.className = 'ti-chip__base';
      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'ti-chip__icon');
      svg.setAttribute('viewBox', '0 0 12 12');
      svg.setAttribute('aria-hidden', 'true');
      svg.innerHTML = ICONS[meta.icon];
      var labelEl = document.createElement('span');
      labelEl.className = 'ti-chip__label' + (mono ? ' mono' : '');
      labelEl.textContent = label;
      base.appendChild(svg);
      base.appendChild(labelEl);
      var flash = document.createElement('span');
      flash.className = 'ti-chip__flash';
      flash.setAttribute('aria-hidden', 'true');
      chip.appendChild(base);
      chip.appendChild(flash);
      return chip;
    }

    function computeTagPositions(persona) {
      var idx = 0;
      var out = [];
      persona.segments.forEach(function (seg) {
        if (seg.tag) out.push({ tagKey: seg.tag, startIndex: idx });
        idx += seg.text.length;
      });
      out.sort(function (a, b) {
        return b.startIndex - a.startIndex;
      });
      return out;
    }

    // ---- reduced motion: persona 1, fully parsed, static, no timers ----
    if (window.TF && window.TF.reducedMotion) {
      renderStatic(PERSONAS[0]);
      return;
    }

    function renderStatic(persona) {
      els.text.textContent = '';
      persona.segments.forEach(function (seg) {
        if (seg.tag) {
          var built = buildRun(seg.tag);
          built.base.textContent = seg.text;
          built.lit.textContent = seg.text;
          built.lit.style.transition = 'none';
          built.el.classList.add('is-lit');
          els.text.appendChild(built.el);
        } else {
          els.text.appendChild(document.createTextNode(seg.text));
        }
      });
      els.caret.style.display = 'none';
      els.chips.innerHTML = '';
      persona.chips.forEach(function (c) {
        var meta = TAG_META[c.tagKey];
        var chip = buildChip(c.tagKey, c.label, meta.mono);
        chip.style.transition = 'none';
        chip.classList.add('is-in');
        var flash = chip.querySelector('.ti-chip__flash');
        if (flash) {
          flash.style.transition = 'none';
          flash.style.opacity = '0';
        }
        els.chips.appendChild(chip);
      });
      setupMiniColumn(persona, els, true);
      els.placedChip.style.transition = 'none';
      els.placedChip.style.opacity = '1';
      els.placedChip.style.transform = 'none';
      els.offer.style.transition = 'none';
      els.offer.style.opacity = '1';
      els.offer.style.transform = 'none';
      els.offerText.innerHTML =
        'Place on ' +
        persona.offer.weekday +
        ', <span class="mono">' +
        persona.offer.time +
        '</span>';
      els.pathDim.style.opacity = '0';
      els.pathLive.style.opacity = '0';
    }

    // ---- mini column: header / hour labels / placed-chip slot ----
    function setupMiniColumn(persona, refs, instant) {
      function apply() {
        refs.dow.textContent = persona.mini.dow;
        refs.hourA.textContent = persona.mini.labelA.text;
        refs.hourA.style.top = persona.mini.labelA.top;
        refs.hourB.textContent = persona.mini.labelB.text;
        refs.hourB.style.top = persona.mini.labelB.top;
        var chip = refs.placedChip;
        chip.style.top = persona.mini.chip.top;
        chip.style.height = persona.mini.chip.height;
        chip.classList.toggle('mini-chip-placed--range', !!persona.mini.range);
        refs.placedTime.textContent = persona.mini.chip.time;
        refs.placedTitle.textContent = persona.mini.chip.title;
      }
      if (instant) {
        apply();
        return;
      }
      var els3 = [refs.dow, refs.hourA, refs.hourB];
      els3.forEach(function (el) {
        el.style.transition = 'opacity 100ms ' + EASE_OUT;
        el.style.opacity = '0';
      });
      setTimeout(function () {
        apply();
        els3.forEach(function (el) {
          el.style.opacity = '1';
        });
      }, 100);
    }

    // ---- scheduler: cancelable setTimeout chain, one per loop session ----
    function makeScheduler(token) {
      var timers = [];
      function after(ms, fn) {
        var id = setTimeout(function () {
          var i = timers.indexOf(id);
          if (i !== -1) timers.splice(i, 1);
          if (token.cancelled) return;
          fn();
        }, ms);
        timers.push(id);
        return id;
      }
      function wait(ms) {
        return new Promise(function (resolve) {
          after(ms, resolve);
        });
      }
      function clearAll() {
        timers.forEach(function (id) {
          clearTimeout(id);
        });
        timers.length = 0;
      }
      return { after: after, wait: wait, clearAll: clearAll };
    }

    // ---- hover pause (SHOULD, pointer devices only) ----
    var paused = false;
    var hoverCapable =
      window.matchMedia && window.matchMedia('(hover: hover)').matches;
    if (hoverCapable) {
      els.demo.addEventListener('pointerenter', function () {
        paused = true;
      });
      els.demo.addEventListener('pointerleave', function () {
        paused = false;
      });
    }
    function waitUnpaused(token, sched) {
      if (!paused) return Promise.resolve();
      return new Promise(function (resolve) {
        (function poll() {
          if (token.cancelled || !paused) {
            resolve();
            return;
          }
          sched.after(120, poll);
        })();
      });
    }

    // ---- typing / untyping char drivers ----
    function typingPhase(persona, refs, sched) {
      return new Promise(function (resolve) {
        // Drop any leftover wrapper elements from the previous persona:
        // untyping shrinks tagged-run text back to '' but never removes the
        // (now-empty, harmless-but-wasteful) .ti-run nodes themselves, and
        // the chip-row's chips are never removed at all (only faded).
        refs.text.textContent = '';
        refs.charOwners.length = 0;
        refs.runByTag = {};
        refs.chips.innerHTML = '';
        refs.chipByTag = {};
        var segIdx = 0;
        var charIdx = 0;
        var cur = null;
        function ensureCur() {
          if (cur) return;
          var seg = persona.segments[segIdx];
          if (seg.tag) {
            var built = buildRun(seg.tag);
            refs.text.appendChild(built.el);
            refs.runByTag[seg.tag] = built.el;
            cur = { kind: 'run', base: built.base, lit: built.lit };
          } else {
            var node = document.createTextNode('');
            refs.text.appendChild(node);
            cur = { kind: 'text', node: node };
          }
        }
        function tick() {
          ensureCur();
          var seg = persona.segments[segIdx];
          var ch = seg.text.charAt(charIdx);
          if (cur.kind === 'run') {
            cur.base.textContent += ch;
            cur.lit.textContent += ch;
          } else {
            cur.node.textContent += ch;
          }
          refs.charOwners.push(cur);
          charIdx++;
          if (charIdx >= seg.text.length) {
            segIdx++;
            charIdx = 0;
            cur = null;
          }
          if (segIdx >= persona.segments.length) {
            resolve();
            return;
          }
          sched.after(TYPE_MS + (Math.random() * TYPE_JITTER * 2 - TYPE_JITTER), tick);
        }
        tick();
      });
    }

    function removeLastChar(refs) {
      var owner = refs.charOwners.pop();
      if (!owner) return;
      if (owner.kind === 'run') {
        owner.base.textContent = owner.base.textContent.slice(0, -1);
        owner.lit.textContent = owner.lit.textContent.slice(0, -1);
      } else {
        owner.node.textContent = owner.node.textContent.slice(0, -1);
      }
    }

    function untypingPhase(persona, refs, sched) {
      return new Promise(function (resolve) {
        hideOffer(refs);
        settleOutChip(refs);
        refs.caret.classList.remove('is-hidden');
        var tags = computeTagPositions(persona);
        var tagPtr = 0;
        var len = persona.text.length;
        function tick() {
          removeLastChar(refs);
          len--;
          while (tagPtr < tags.length && len <= tags[tagPtr].startIndex) {
            var t = tags[tagPtr];
            var runEl = refs.runByTag[t.tagKey];
            if (runEl) runEl.classList.remove('is-lit');
            var chipEl = refs.chipByTag[t.tagKey];
            if (chipEl) chipEl.classList.remove('is-in');
            tagPtr++;
          }
          if (len <= 0) {
            resolve();
            return;
          }
          sched.after(BACKSPACE_MS, tick);
        }
        tick();
      });
    }

    // ---- reveal: tag highlight + chip pop, staggered ----
    function revealPhase(persona, refs, sched) {
      return new Promise(function (resolve) {
        var chipEls = persona.chips.map(function (c) {
          var meta = TAG_META[c.tagKey];
          var el = buildChip(c.tagKey, c.label, meta.mono);
          refs.chips.appendChild(el);
          refs.chipByTag[c.tagKey] = el;
          return el;
        });
        persona.chips.forEach(function (c, i) {
          sched.after(i * TAG_STAGGER, function () {
            var runEl = refs.runByTag[c.tagKey];
            if (runEl) runEl.classList.add('is-lit');
            chipEls[i].classList.add('is-in');
          });
        });
        var total = (persona.chips.length - 1) * TAG_STAGGER + 280;
        sched.after(total, resolve);
      });
    }

    // ---- landing: offer + connecting line + chip travel + rim flash ----
    function showOffer(persona, refs) {
      refs.offerText.innerHTML =
        'Place on ' +
        persona.offer.weekday +
        ', <span class="mono">' +
        persona.offer.time +
        '</span>';
      refs.offer.style.opacity = '0';
      refs.offer.animate(
        [
          { opacity: 0, transform: 'translateY(6px)' },
          { opacity: 1, transform: 'translateY(0)' },
        ],
        { duration: 240, easing: EASE_SETTLE, fill: 'forwards' }
      );
    }

    function hideOffer(refs) {
      refs.offer.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 160,
        easing: EASE_OUT,
        fill: 'forwards',
      });
    }

    function pressKbd(refs) {
      refs.kbd.animate(
        [
          { transform: 'scale(1)' },
          { transform: 'scale(0.97)', offset: 0.5 },
          { transform: 'scale(1)' },
        ],
        { duration: 200, easing: EASE_OUT }
      );
    }

    function travelChip(refs) {
      refs.placedChip.animate(
        [
          { opacity: 0, transform: 'translate(-10px, 8px) scale(0.92)' },
          { opacity: 1, transform: 'translate(0, 0) scale(1)' },
        ],
        { duration: 320, easing: EASE_SETTLE, fill: 'forwards' }
      );
    }

    function settleOutChip(refs) {
      refs.placedChip.animate(
        [
          { opacity: 1, transform: 'translate(0, 0) scale(1)' },
          { opacity: 0, transform: 'translateY(6px) scale(0.985)' },
        ],
        { duration: 240, easing: EASE_SETTLE, fill: 'forwards' }
      );
    }

    function flashPlacedChip(refs) {
      refs.placedChip.classList.remove('is-flash');
      void refs.placedChip.offsetWidth;
      refs.placedChip.classList.add('is-flash');
    }

    // Quadratic curve, kbd -> placed-chip slot. Dim phosphor for the whole
    // line; a short aqua sub-curve (last 30%, via De Casteljau split at
    // t=0.7) fades in near the end so the line "catches" the live meaning
    // right before the chip lands (direction §2.1 / typeit.md).
    function updateLinkPath(refs) {
      var demoRect = refs.demo.getBoundingClientRect();
      var kbdRect = refs.kbd.getBoundingClientRect();
      var chipRect = refs.placedChip.getBoundingClientRect();
      var sx = kbdRect.left + kbdRect.width / 2 - demoRect.left;
      var sy = kbdRect.top + kbdRect.height / 2 - demoRect.top;
      var ex = chipRect.left - demoRect.left;
      var ey = chipRect.top + chipRect.height / 2 - demoRect.top;
      var cx = (sx + ex) / 2 - 24;
      var cy = (sy + ey) / 2;
      refs.pathDim.setAttribute(
        'd',
        'M' + sx + ',' + sy + ' Q' + cx + ',' + cy + ' ' + ex + ',' + ey
      );
      var t = 0.7;
      var q1x = sx + (cx - sx) * t,
        q1y = sy + (cy - sy) * t;
      var q2x = cx + (ex - cx) * t,
        q2y = cy + (ey - cy) * t;
      var r1x = q1x + (q2x - q1x) * t,
        r1y = q1y + (q2y - q1y) * t;
      refs.pathLive.setAttribute(
        'd',
        'M' + r1x + ',' + r1y + ' Q' + q2x + ',' + q2y + ' ' + ex + ',' + ey
      );
    }

    function drawLink(refs, sched) {
      refs.pathDim.style.opacity = '1';
      refs.pathLive.style.opacity = '0';
      updateLinkPath(refs);
      if (window.TF && window.TF.drawPath) {
        window.TF.drawPath(refs.pathDim, { duration: 280 });
      }
      sched.after(180, function () {
        refs.pathLive.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 100,
          easing: EASE_OUT,
          fill: 'forwards',
        });
      });
    }

    function fadeLink(refs) {
      [refs.pathDim, refs.pathLive].forEach(function (p) {
        p.animate([{ opacity: getComputedStyle(p).opacity }, { opacity: 0 }], {
          duration: 240,
          easing: EASE_OUT,
          fill: 'forwards',
        });
      });
    }

    function landingPhase(persona, refs, sched) {
      return new Promise(function (resolve) {
        showOffer(persona, refs);
        drawLink(refs, sched);
        sched.after(160, function () {
          pressKbd(refs);
          travelChip(refs);
        });
        sched.after(480, function () {
          flashPlacedChip(refs);
          fadeLink(refs);
        });
        sched.after(720, resolve);
      });
    }

    function holdPhase(sched) {
      return new Promise(function (resolve) {
        sched.after(HOLD_MS, resolve);
      });
    }

    // ---- DOM reset (called on loop start / restart-from-scroll-in) ----
    function resetComposerDom() {
      els.text.textContent = '';
      els.chips.innerHTML = '';
      els.caret.classList.add('is-hidden');
      [els.offer, els.placedChip].forEach(function (el) {
        if (el.getAnimations) {
          el.getAnimations().forEach(function (a) {
            a.cancel();
          });
        }
      });
      els.offer.style.opacity = '0';
      els.offer.style.transform = 'none';
      els.placedChip.style.opacity = '0';
      els.placedChip.style.transform = 'translate(-10px, 8px) scale(0.92)';
      els.placedChip.classList.remove('is-flash');
      els.pathDim.setAttribute('d', '');
      els.pathDim.style.opacity = '1';
      els.pathLive.setAttribute('d', '');
      els.pathLive.style.opacity = '0';
      els.dow.textContent = '';
      els.hourA.textContent = '';
      els.hourB.textContent = '';
    }

    // ---- loop state: persists the current persona index across pause ----
    var state = { index: 0 };
    var token = null;
    var activeSched = null;

    async function runCycle(myToken, sched) {
      var firstIter = true;
      while (!myToken.cancelled) {
        var persona = PERSONAS[state.index];
        var refs = {
          text: els.text,
          caret: els.caret,
          chips: els.chips,
          offer: els.offer,
          offerText: els.offerText,
          kbd: els.kbd,
          pathDim: els.pathDim,
          pathLive: els.pathLive,
          demo: els.demo,
          dow: els.dow,
          hourA: els.hourA,
          hourB: els.hourB,
          placedChip: els.placedChip,
          placedTime: els.placedTime,
          placedTitle: els.placedTitle,
          charOwners: [],
          runByTag: {},
          chipByTag: {},
        };
        setupMiniColumn(persona, refs, firstIter);
        firstIter = false;

        await waitUnpaused(myToken, sched);
        if (myToken.cancelled) return;
        await typingPhase(persona, refs, sched);
        if (myToken.cancelled) return;
        await waitUnpaused(myToken, sched);
        if (myToken.cancelled) return;
        await revealPhase(persona, refs, sched);
        if (myToken.cancelled) return;
        await waitUnpaused(myToken, sched);
        if (myToken.cancelled) return;
        await landingPhase(persona, refs, sched);
        if (myToken.cancelled) return;
        await waitUnpaused(myToken, sched);
        if (myToken.cancelled) return;
        await holdPhase(sched);
        if (myToken.cancelled) return;
        await waitUnpaused(myToken, sched);
        if (myToken.cancelled) return;
        await untypingPhase(persona, refs, sched);
        if (myToken.cancelled) return;

        state.index = (state.index + 1) % PERSONAS.length;
        await sched.wait(INTER_PERSONA_GAP);
      }
    }

    function startLoop() {
      if (token && !token.cancelled) return;
      resetComposerDom();
      token = { cancelled: false };
      activeSched = makeScheduler(token);
      runCycle(token, activeSched);
    }

    function stopAndFreeze() {
      if (token) token.cancelled = true;
      if (activeSched) {
        activeSched.clearAll();
        activeSched = null;
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      if (!window.TF || !window.TF.onVisible) return;
      window.TF.onVisible(
        rootEl,
        function (visible) {
          if (visible) startLoop();
          else stopAndFreeze();
        },
        { once: false, threshold: 0.3 }
      );
    });
  })();
</script>

