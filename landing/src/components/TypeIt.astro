---
// §6.2 — "Type it. It lands." Static token-faithful mock of the smart
// input: parse span underlined in aqua, the Place offer beneath, and the
// placed chip on a Friday column fragment. Natural-language dates are
// shipped (chrono parser + the command bar's date grammar).
---

<section class="section" id="type-it">
  <div class="container grid-2">
    <div class="copy" data-reveal>
      <h2 class="display-section">Type it. It lands.</h2>
      <p class="body-copy">
        Dates hide in the words you already use. Taskflow reads them as you
        type, offers the slot, and one Enter places the task on your week.
      </p>
    </div>
    <figure
      class="demo"
      role="img"
      aria-label="The smart input holding the text Email vendor friday 4pm, with friday 4pm underlined in aqua and an offer reading Place on Friday, 4:00 PM. Beside it, a Friday column with the task placed at 16:00."
      data-reveal
    >
      <div class="input-card">
        <div class="input-well">
          <span class="input-text"
            >Email vendor <span class="parse">friday 4pm</span></span
          >
          <span class="caret" aria-hidden="true"></span>
        </div>
        <div class="offer">
          <span class="offer-text">Place on Friday, 4:00 PM</span>
          <kbd class="key mono">&#9166;</kbd>
        </div>
      </div>
      <div class="mini-col">
        <div class="mini-head">
          <span class="dow">FRI</span>
        </div>
        <div class="mini-body">
          <span class="mini-hour mono" style="top:25%">3 PM</span>
          <span class="mini-hour mono" style="top:75%">5 PM</span>
          <div
            class="chip mini-chip-placed"
            style="--chip-c: var(--aqua); top:50%; height:25%"
          >
            <span class="c-t mono">16:00</span>
            <span class="c-ti">Email vendor</span>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .grid-2 {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 56px;
    align-items: center;
  }

  .copy .body-copy {
    margin-top: 16px;
    max-width: 44ch;
  }

  .demo {
    margin: 0;
    display: flex;
    gap: 28px;
    align-items: stretch;
  }

  .input-card {
    flex: 1;
    align-self: center;
  }

  .input-well {
    display: flex;
    align-items: center;
    background: var(--surface-2);
    border: 1px solid var(--hairline-strong);
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
    color: var(--ink);
  }

  .parse {
    text-decoration: underline;
    text-decoration-color: var(--aqua);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .caret {
    width: 1.5px;
    height: 16px;
    margin-left: 2px;
    background: var(--aqua);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .offer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--aqua-film-08);
    box-shadow: inset 0 0 0 1px var(--aqua-rim);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }

  .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 5px;
    background: var(--surface-2);
    box-shadow: var(--edge-machined);
    font-size: 11px;
    color: var(--ink-2);
  }

  .mini-col {
    width: 190px;
    flex: none;
    background: var(--surface-1);
    border-radius: 10px;
    box-shadow: var(--edge-machined), var(--shadow-2);
  }

  .mini-head {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    border-bottom: 1px solid var(--hairline);
  }

  .dow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .mini-body {
    position: relative;
    height: 190px;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(25% - 1px),
      var(--hairline) calc(25% - 1px),
      var(--hairline) 25%
    );
  }

  .mini-hour {
    position: absolute;
    left: 8px;
    transform: translateY(-50%);
    font-size: 10px;
    color: var(--ink-muted);
  }

  .mini-chip-placed {
    position: absolute;
    left: 46px;
    right: 8px;
    display: flex;
    gap: 5px;
    padding: 3px 7px;
    white-space: nowrap;
    overflow: hidden;
  }

  .c-t {
    font-size: 11px;
    padding-top: 1.5px;
  }

  .c-ti {
    font-size: 12px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  @media (max-width: 860px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .demo {
      flex-wrap: wrap;
    }
  }
</style>
